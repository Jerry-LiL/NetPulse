# Registry
NETPULSE_DB=netpulse.db
NETPULSE_SEED=1
NETPULSE_SEED_TCP_HOST=127.0.0.1
NETPULSE_SEED_TCP_PORT=5000
NETPULSE_SEED_SNMP_HOST=127.0.0.1
NETPULSE_SEED_SNMP_PORT=1161

# Agent
NETPULSE_REGISTRY_URL=http://127.0.0.1:5000
# NETPULSE_DEVICES_FILE=examples/devices.local
NETPULSE_POLL_INTERVAL=15
NETPULSE_WORKERS=4
NETPULSE_HEALTH_ADDR=0.0.0.0
NETPULSE_HEALTH_PORT=8080
NETPULSE_CHECK_TIMEOUT_MS=2000
NETPULSE_LOG_LEVEL=info
# NETPULSE_RUN_ONCE=1
